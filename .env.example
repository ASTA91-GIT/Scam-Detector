# ==============================================================================
# SCAMGUARD AI - PRODUCTION ENVIRONMENT CONFIGURATION
# ==============================================================================

# Core Application Environment
FLASK_ENV=production
FLASK_DEBUG=false
SECRET_KEY=change-this-to-a-secure-random-64-character-hex-secret
JWT_SECRET_KEY=change-this-to-a-secure-random-64-character-hex-jwt-secret
PORT=5000

# Base URLs
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5000

# Database Configuration (MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/
DATABASE_NAME=job_scam_detector

# Local Authoritative AI Engine (Ollama)
OLLAMA_BASE_URL=http://localhost:11434
AI_MODEL=llama3.2:3b

# Internal Mail Service (Node.js + Nodemailer)
MAIL_SERVICE_URL=http://localhost:5001
MAIL_SERVICE_SECRET=change-this-to-an-internal-service-secret-token

# SMTP Relay Configuration (Used by Node.js Mail Service)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=alerts@example.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=security@scamguard.ai
SMTP_FROM_NAME=ScamGuard AI Forensics

# File Upload & Document Security
MAX_FILE_SIZE=10485760
MAX_DOCUMENT_PAGES=20
UPLOAD_FOLDER=uploads
FILE_RETENTION_HOURS=24

# Security, Telemetry & Thresholds
RATE_LIMIT_ENABLED=true
DOMAIN_INTELLIGENCE_ENABLED=true
HIGH_RISK_EMAIL_THRESHOLD=75
SEED_TEST_USER=false